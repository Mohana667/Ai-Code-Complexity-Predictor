# --- App ---
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB_NAME=

# --- Firebase Authentication ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

MAX_CODE_SIZE_BYTES=512000

# --- Admin bootstrap ---
# Comma-separated list of emails that get admin access on next sign-in.
# Leave blank for no admins. Example: ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=admin@gmail.com
